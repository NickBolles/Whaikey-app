# Copy to .env.local for local development. Do NOT commit real secrets.

# --- Database ---------------------------------------------------------------
# Postgres everywhere. Local dev / tests use PGlite (an in-process WASM
# Postgres) — no server, no network. Production uses hosted Postgres (Supabase).
#
# Local (default if unset): a PGlite data directory.
DATABASE_URL="file:./data/whaikey"
# Production: your Supabase Postgres connection string. Use the connection
# POOLER URL (port 6543) for serverless — the driver disables prepared
# statements so it works with pgbouncer transaction mode.
# DATABASE_URL="postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# --- Auth (Better Auth, social login only) ----------------------------------
# The app's public base URL. Locally this is http://localhost:3000; in
# production set it to your deployed URL (e.g. https://whaikey.vercel.app).
BETTER_AUTH_URL="http://localhost:3000"
# REQUIRED in production. Generate with `openssl rand -base64 32`; production
# startup fails closed when this is absent (the shown value is development-only).
BETTER_AUTH_SECRET="dev-only-secret-change-me"

# --- Phone discovery (docs/SOCIAL.md D8 as amended) --------------------------
# Key for the HMAC under which phone numbers are stored (never in the clear).
# RECOMMENDED in production: a dedicated key you NEVER rotate — stored hashes
# only match numbers hashed with the same key, so rotating it makes every
# saved number undiscoverable and re-claimable. When unset, the hash falls
# back to BETTER_AUTH_SECRET, which couples the phone graph to a secret you
# may legitimately want to rotate. Generate with `openssl rand -base64 32`.
# WHAIKEY_PHONE_KEY=""

# --- Native app (Capacitor) --------------------------------------------------
# The origin the iOS/Android WebView loads (docs/NATIVE_APP.md §2.2). Falls back
# to NEXT_PUBLIC_APP_URL. Must be https — `pnpm native:check --release` enforces
# it. Also the allowlist for universal-link deep links.
# CAP_SERVER_URL="https://app.whaikey.com"
# NEXT_PUBLIC_APP_URL="https://app.whaikey.com"
#
# Deep-link domain verification. Both /.well-known/ routes 404 until these are
# set, which leaves links unverified (they open the browser) rather than broken.
# APPLE_TEAM_ID="ABCDE12345"                 # Apple Developer → Membership
# Comma-separated SHA-256 of the *app signing* key — under Play App Signing that
# is Google's key, not your upload key (Play Console → Release → Setup → App signing).
# ANDROID_CERT_FINGERPRINTS="AA:BB:CC:..."

# Google OAuth (create at https://console.cloud.google.com/apis/credentials).
# Authorized redirect URI: https://<your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Apple OAuth (optional, can wait).
# APPLE_CLIENT_ID=""
# APPLE_CLIENT_SECRET=""

# --- AI (OpenRouter preferred; direct Anthropic fallback) -------------------
# OpenRouter serves the Anthropic Messages API and is preferred whenever set.
OPENROUTER_API_KEY=""
# Existing direct-Anthropic fallback (only used when OPENROUTER_API_KEY is absent).
ANTHROPIC_API_KEY=""
# Optional model overrides. Defaults are OpenRouter-compatible IDs when the
# OpenRouter key is set; direct Anthropic defaults otherwise.
# WHAIKEY_CHAT_MODEL="anthropic/claude-sonnet-4"
# WHAIKEY_FAST_MODEL="anthropic/claude-haiku-4.5"

# --- Security headers -------------------------------------------------------
# The Content-Security-Policy in next.config.ts ships REPORT-ONLY so a missed
# directive shows up at /api/csp-report instead of as a broken page. Set this
# to "true" to enforce it, once the reports from a real deploy are clean. The
# e2e suite already runs enforced, so this is a deliberate flip, not a leap.
# WHAIKEY_CSP_ENFORCE="true"

# --- Native shell version floor ---------------------------------------------
# The native app loads the deployed site over HTTPS, so a UI change ships
# without store review — and a bad deploy reaches every installed app at once.
# /api/native/manifest is the floor: a shell older than this shows "Update
# Whaikey" instead of a UI it can't run. Unset ⇒ no floor, nobody is locked out.
# Raising it above every released build is the kill switch (docs/NATIVE_APP.md
# §2.2); the optional notice replaces the default line on that screen.
# WHAIKEY_MIN_SHELL_VERSION="1.4.0"
# WHAIKEY_SHELL_NOTICE="A bad build went out; please update."
#
# Where the update screen sends people. Public, and only used there.
# NEXT_PUBLIC_IOS_STORE_URL="https://apps.apple.com/app/id..."
# NEXT_PUBLIC_ANDROID_STORE_URL="https://play.google.com/store/apps/details?id=com.whaikey.app"

# --- Barcode scanning -------------------------------------------------------
# When a scanned UPC misses our own DB, the server tries free external
# lookups (UPCitemdb trial, then Open Food Facts) and only ever uses the
# result transiently to match our catalog. Set "off" to disable (e2e does).
# WHAIKEY_UPC_LOOKUP="off"
#
# Optional whiskey-specialized UPC provider, tried before the generic ones
# (e.g. a licensed WhiskyDB endpoint). URL template must contain "{upc}";
# the key, when set, is sent as an "API-Key" header. Unset ⇒ skipped.
# WHAIKEY_WHISKY_UPC_URL="https://<your-endpoint>/api/v1/spirits?barcode={upc}"
# WHAIKEY_WHISKY_UPC_KEY="..."

# --- Catalog ingest sources -------------------------------------------------
# Vinmonopolet (Norway) official products API — free key from
# https://api.vinmonopolet.no/ (subscribe to the products API). Used by
# `pnpm ingest vinmonopolet` only; never needed at runtime.
# VINMONOPOLET_API_KEY="..."

# --- Moderation (PLAN.md §9.4) ----------------------------------------------
# Comma-separated user ids allowed to open /admin/reports and act on the queue.
# Ids, not emails: an email is a claim the identity provider can change. An
# EMPTY or unset value grants nobody — a deploy that forgets this gets a queue
# no one can open, which is the failure worth having. Non-operators get 404 on
# both the page and /api/admin/moderation, so the surface is not discoverable.
# WHAIKEY_OPERATOR_IDS="usr_abc123,usr_def456"

# --- Legal identity (PLAN.md §9.3) ------------------------------------------
# /terms and /privacy need a legal entity, a jurisdiction and a contact address,
# and code cannot invent them: a policy naming the WRONG entity is not a smaller
# problem than one naming none. Until all three are set, both pages render with
# a visible "this document is not finished" banner — that banner is the
# store-readiness check. NEXT_PUBLIC_ because the pages are static.
# NEXT_PUBLIC_LEGAL_ENTITY="Whaikey, LLC"
# NEXT_PUBLIC_LEGAL_JURISDICTION="the State of Delaware, USA"
# NEXT_PUBLIC_SUPPORT_EMAIL="support@whaikey.com"
# ISO date the current policy text took effect. Update it when the text changes.
# NEXT_PUBLIC_POLICY_EFFECTIVE_DATE="2026-09-04"
