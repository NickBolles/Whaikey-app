# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# Verified public CA intermediate used only by the catalog-sync TTB fetch.
!.github/certificates/entrust-ov-tls-issuing-rsa-ca-2.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local sqlite
/data/

# playwright
/test-results/
/playwright-report/

# pnpm store created when generating visual baselines in the Playwright container
.pnpm-store/

# generated verification-queue controller reports (scripts/verify-sold.ts)
/artifacts/

# capacitor native projects — generated by `cap add`, committed from Phase 2
# onward (docs/NATIVE_APP.md §2.4)
/ios/
/android/
# server origin baked into the offline shell by scripts/native-sync.mjs
/native/shell/config.js
