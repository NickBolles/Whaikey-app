{
  "name": "whaikey",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20.19.0 <23",
    "pnpm": ">=10.17.1 <11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "build:next": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:push": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed/run.ts",
    "ingest": "tsx scripts/ingest.ts",
    "enrich:claude-code": "tsx scripts/enrich-claude-code.ts",
    "verify-sold": "tsx scripts/verify-sold.ts",
    "feedback:review": "tsx scripts/review-whiskey-feedback.ts",
    "native:check": "node scripts/native-check.mjs",
    "native:sync": "node scripts/native-sync.mjs",
    "native:assets": "node scripts/native-assets.mjs",
    "native:add:ios": "cap add ios",
    "native:add:android": "cap add android",
    "native:open:ios": "cap open ios",
    "native:open:android": "cap open android",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test --project=functional",
    "e2e:visual": "playwright test --project=visual-mobile --project=visual-desktop",
    "e2e:update": "playwright test --project=visual-mobile --project=visual-desktop --update-snapshots",
    "e2e:update:ci": "bash scripts/e2e-update-ci.sh",
    "e2e:all": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@capacitor-mlkit/barcode-scanning": "^8.1.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@electric-sql/pglite": "^0.5.4",
    "@types/qrcode": "^1.5.6",
    "better-auth": "^1.6.23",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "lucide-react": "^1.25.0",
    "next": "16.2.11",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
